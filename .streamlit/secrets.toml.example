# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# `.streamlit/secrets.toml` is gitignored — never commit it.
# In production, paste the same keys into the Streamlit Community Cloud
# secrets manager instead (App → Settings → Secrets).

# Supabase → Project Settings → API
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# service_role key — bypasses RLS, used only by the admin page. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# Password for the admin (submissions) page. Choose something strong.
ADMIN_PASSWORD = "change-me"
